import SwiftUI

/// Demo-only send/receive UI. It does not move funds or hold keys.
struct ActionSheet: View {
    enum Mode { case send, receive }
    let mode: Mode
    @Environment(\.dismiss) private var dismiss
    @State private var address = ""
    @State private var amount = ""

    var body: some View {
        NavigationStack {
            Form {
                if mode == .send {
                    Section("Recipient") { TextField("Address", text: $address).textInputAutocapitalization(.never) }
                    Section("Amount") { TextField("0.00", text: $amount).keyboardType(.decimalPad) }
                    Section { Button("Review (demo)") { dismiss() }.frame(maxWidth: .infinity) }
                } else {
                    Section("Your demo address") {
                        Text("demo-0000-0000-0000").font(.system(.body, design: .monospaced))
                        ShareLink(item: "demo-0000-0000-0000") { Label("Share", systemImage: "square.and.arrow.up") }
                    }
                }
            }
            .scrollContentBackground(.hidden)
            .background(AppBackground())
            .navigationTitle(mode == .send ? "Send" : "Receive")
            .navigationBarTitleDisplayMode(.inline)
            .toolbar { Button("Close") { dismiss() } }
        }
    }
}

struct ActivityView: View {
    @Environment(PortfolioStore.self) private var store

    var body: some View {
        List(store.transactions) { tx in
            HStack {
                Image(systemName: icon(tx.kind))
                    .frame(width: 36, height: 36)
                    .background(Theme.card, in: Circle())
                VStack(alignment: .leading) {
                    Text(tx.kind.rawValue).fontWeight(.semibold)
                    Text(tx.date, style: .relative).font(.caption).foregroundStyle(.secondary)
                }
                Spacer()
                Text("\(tx.amount.formatted()) \(tx.symbol)").fontWeight(.semibold)
            }
            .listRowBackground(Theme.card)
        }
        .scrollContentBackground(.hidden)
        .background(AppBackground())
        .navigationTitle("Activity")
    }

    private func icon(_ k: Transaction.Kind) -> String {
        switch k {
        case .sent: "arrow.up"
        case .received: "arrow.down"
        case .swapped: "arrow.left.arrow.right"
        }
    }
}

